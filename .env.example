# ─────────────────────────────────────────────────────────────────────────────
# TRENDS environment. Copy to .env (development) or set in your host's secret
# store (production). Never commit real values. Unset optional integrations
# run in a clearly labelled file-export / test mode.
# ─────────────────────────────────────────────────────────────────────────────

# Required ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://trends:CHANGE_ME@localhost:5432/trends"
# Public base URL, used in emails, payment links and PDF footers (no trailing slash).
APP_URL="http://localhost:3000"

# Seeding ─────────────────────────────────────────────────────────────────────
# Demo data loads by default outside production only. Set to "false" to skip, "true" to force.
# SEED_DEMO="false"
# Password for all demo users (development only). If unset a random one is printed once.
# DEV_ADMIN_PASSWORD=""
# Used only by `npm run create-admin` when not run in a terminal.
# ADMIN_PASSWORD=""

# Email ───────────────────────────────────────────────────────────────────────
# "preview" (default) logs emails in Settings → Email log and sends nothing.
EMAIL_PROVIDER="preview"
# EMAIL_PROVIDER="smtp"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="TRENDS <billing@yourcompany.com>"

# Online payments ─────────────────────────────────────────────────────────────
# Leave empty to hide online payment links. "simulated" is a TEST MODE gateway
# (no money moves) and is refused in production unless ALLOW_SIMULATED_PAYMENTS=true.
PAYMENT_GATEWAY=""
# PAYMENT_GATEWAY="simulated"
# SIMULATED_GATEWAY_SECRET="any-long-random-string"
# ALLOW_SIMULATED_PAYMENTS="false"
# PAYMENT_GATEWAY="stripe"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# File storage ────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# STORAGE_DRIVER="s3"
# S3_ENDPOINT_URL=""
# S3_ACCESS_TOKEN=""
# Optional malware scanner endpoint, e.g. a ClamAV REST wrapper. Receives the raw file
# and must answer JSON {"infected": true|false}.
# SCANNER_URL=""
# Development only: accept uploads without a scanner.
ALLOW_UNSCANNED_FILES="true"

# Finance and broadcast integrations (all optional) ───────────────────────────
# TALLY_URL="http://tally-host:9000"
# SAP_API_URL=""
# SAP_USERNAME=""
# SAP_PASSWORD=""
# AMS_API_URL=""
# AMS_API_TOKEN=""
# AUTOMATION_API_URL=""
# AUTOMATION_API_TOKEN=""

# Scheduled jobs over HTTP (optional). Enables POST /api/jobs with
# "Authorization: Bearer <CRON_SECRET>". Prefer `npm run jobs:run` from cron.
# CRON_SECRET=""

# Diagnostics ─────────────────────────────────────────────────────────────────
# PRISMA_LOG="query"

# Tests ───────────────────────────────────────────────────────────────────────
# A separate, disposable database for integration tests. Never point at real data.
# TEST_DATABASE_URL="postgresql://trends:CHANGE_ME@localhost:5432/trends_test"
# E2E_BASE_URL="http://localhost:3000"
# E2E_PASSWORD=""   # the DEV_ADMIN_PASSWORD used when seeding the e2e database
